{
  "port": 4173,
  "refreshMinutes": 10,
  "browserPollSeconds": 60,
  "githubLogin": "SV-li-zhenhui",
  "trackedRepositories": [
    "SVisions/OCT-Software",
    "SVisions/OCT-Product"
  ],
  "prResponsibility": {
    "historicalAfterDays": 60
  },
  "codeExecutor": {
    "enabled": false
  },
  "githubActions": {
    "enabled": false
  },
  "workflowRouting": {
    "schemaVersion": 1,
    "enabled": true,
    "maxHops": 8,
    "rules": [
      {
        "id": "pr-events-to-pr-reviewer",
        "source": "root",
        "enabled": true,
        "priority": 100,
        "fallback": false,
        "condition": {
          "op": "oneOf",
          "path": "eventType",
          "values": [
            "pull_request.observed",
            "pull_request.created",
            "pull_request.updated",
            "pull_request.completed",
            "pull_request.left_scope",
            "pull_request.classified",
            "pull_request.status"
          ]
        },
        "targets": [
          {
            "type": "role",
            "id": "pr-reviewer"
          }
        ],
        "onMatch": "stop"
      },
      {
        "id": "issue-events-to-requirements",
        "source": "root",
        "enabled": true,
        "priority": 90,
        "fallback": false,
        "condition": {
          "op": "oneOf",
          "path": "eventType",
          "values": [
            "issue.observed",
            "issue.created",
            "issue.updated",
            "issue.completed",
            "issue.left_scope",
            "issue.classified",
            "issue.status"
          ]
        },
        "targets": [
          {
            "type": "role",
            "id": "requirements-analyst"
          }
        ],
        "onMatch": "stop"
      },
      {
        "id": "owner-triage-fallback",
        "source": "root",
        "enabled": true,
        "priority": 0,
        "fallback": true,
        "condition": null,
        "targets": [
          {
            "type": "person",
            "id": "SV-li-zhenhui"
          }
        ],
        "onMatch": "stop"
      }
    ]
  },
  "brain": {
    "enabled": true,
    "provider": "ollama",
    "model": "qwen3.5:9b",
    "baseUrl": "http://127.0.0.1:11434",
    "contextTokens": 8192,
    "timeoutMs": 45000,
    "maxAssessmentsPerRefresh": 3
  },
  "employees": {
    "prReviewer": {
      "enabled": true,
      "name": "PR 推进员工",
      "policyVersion": 1,
      "tickMinutes": 2,
      "maxJobsPerTick": 2,
      "maxAttempts": 3,
      "retryMinutes": [1, 5, 30],
      "maxPatchCharacters": 24000,
      "memoryLimit": 1000,
      "memoryOutboxLimit": 100,
      "jobLimit": 500,
      "allowRemoteCodeContext": false,
      "brain": {}
    }
  },
  "dingtalk": {
    "enabled": true,
    "selfUserId": "1137300121374851",
    "notifyMinimumScore": 80,
    "maxNotificationsPerRun": 5
  }
}
