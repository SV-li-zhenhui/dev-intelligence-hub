{
  "port": 4173,
  "refreshMinutes": 10,
  "browserPollSeconds": 60,
  "githubLogin": "SV-li-zhenhui",
  "trackedRepositories": [
    "SVisions/OCT-Software",
    "SVisions/OCT-Product"
  ],
  "prResponsibility": {
    "historicalAfterDays": 60
  },
  "codeExecutor": {
    "enabled": false
  },
  "githubActions": {
    "enabled": false
  },
  "workflowRouting": {
    "schemaVersion": 1,
    "enabled": true,
    "maxHops": 8,
    "rules": [
      {
        "id": "pr-events-to-pr-engineer",
        "source": "root",
        "enabled": true,
        "priority": 100,
        "fallback": false,
        "condition": {
          "op": "oneOf",
          "path": "eventType",
          "values": [
            "pull_request.observed",
            "pull_request.created",
            "pull_request.updated",
            "pull_request.completed",
            "pull_request.left_scope",
            "pull_request.classified",
            "pull_request.status"
          ]
        },
        "targets": [
          {
            "type": "role",
            "id": "pr-engineer"
          }
        ],
        "onMatch": "stop"
      },
      {
        "id": "issue-events-to-requirements",
        "source": "root",
        "enabled": true,
        "priority": 90,
        "fallback": false,
        "condition": {
          "op": "oneOf",
          "path": "eventType",
          "values": [
            "issue.observed",
            "issue.created",
            "issue.updated",
            "issue.completed",
            "issue.left_scope",
            "issue.classified",
            "issue.status"
          ]
        },
        "targets": [
          {
            "type": "role",
            "id": "requirements-analyst"
          }
        ],
        "onMatch": "stop"
      },
      {
        "id": "owner-triage-fallback",
        "source": "root",
        "enabled": true,
        "priority": 0,
        "fallback": true,
        "condition": null,
        "targets": [
          {
            "type": "person",
            "id": "SV-li-zhenhui"
          }
        ],
        "onMatch": "stop"
      }
    ]
  },
  "workCoordination": {
    "enabled": true,
    "tickSeconds": 30,
    "intakeLimit": 100,
    "workLimit": 20,
    "dispatchLimit": 50,
    "attentionLimit": 50,
    "proposalLimit": 50,
    "conditionLimit": 50,
    "leaseDurationMs": 180000,
    "resolveTimeoutMs": 5000,
    "decisionTimeoutMs": 150000,
    "maxAttempts": 3,
    "retryBaseMs": 30000,
    "retryMaxMs": 900000,
    "factMaximumAgeMs": 900000,
    "policy": {
      "version": 1,
      "capabilityRoles": {
        "coordination": "orchestrator",
        "requirements": "requirements-analyst",
        "pr-review": "pr-engineer",
        "development": "developer",
        "testing": "tester"
